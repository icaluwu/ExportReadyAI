# Copy to .env.local for local development:
#   cp .env.example .env.local

# Supabase (required for auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL for auth email redirects and SEO metadata.
# Local: http://localhost:3000
# Netlify preview: optional — DEPLOY_PRIME_URL is used automatically when unset
# Production: https://exportready.web.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider (server-only; required for /api/analyze, /api/chat, /api/hs-code)
# Default provider can be switched via AI_PROVIDER_BASE_URL and AI_MODEL.
AI_PROVIDER_BASE_URL=https://router.bynara.id/v1
AI_PROVIDER_API_KEY=your-ai-provider-api-key
AI_MODEL=agnes-2.5-flash

# Kept for backward compatibility; you may remove this if unused.
GEMINI_API_KEY=your-gemini-api-key

# Supabase service role (server-only; required for payment webhooks & admin writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Midtrans payment (server-only except client key)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Skip env validation during build (CI/Docker only — not for production deploys)
# SKIP_ENV_VALIDATION=true

# Google Search Console verification (optional)
# Get your code from: https://search.google.com/search-console
# Choose "HTML tag" method, copy only the content value (without meta tag)
# Example: NEXT_PUBLIC_GSC_VERIFICATION=abc123xyz456...
NEXT_PUBLIC_GSC_VERIFICATION=

# Force strict payment validation on non-production deployments
REQUIRE_PRODUCTION_PAYMENTS=false
